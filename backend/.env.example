# Copy this file to .env and fill in real values before running the backend.

# Used by the AI assistant service (services/ai_assistant.py) to generate
# natural-language explanations and answer learner questions.
# If both are left blank, the assistant falls back to a grounded, templated
# (non-LLM) response engine that still uses your real profile/career data.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Free tier, 10k quota units/day: https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project). YouTube is a SECONDARY
# "also recommended" section under each milestone -- if left blank it shows a
# plain YouTube search link instead of real ranked videos. The core course
# recommendations + learning path come from the local synthetic dataset.
YOUTUBE_API_KEY=

# Course catalog + fitted-model cache (defaults are fine). Regenerate the
# dataset with:  python -m scripts.generate_dataset
# COURSES_CSV=app/data/courses.csv
# ML_CACHE_DIR=app/ml/cache

# SQLite by default so the prototype runs with zero setup. Swap for a real
# Postgres URL in production (e.g. postgresql://user:pass@host:5432/dbname).
DATABASE_URL=sqlite:///./learning_path.db

# Comma separated list of origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
