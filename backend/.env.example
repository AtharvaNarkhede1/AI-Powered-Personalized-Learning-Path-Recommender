# ============================================================================
#  Copy this file to  backend/.env  and fill in the keys you want.
#      Windows:  copy .env.example .env
#      macOS/Linux:  cp .env.example .env
#  ALL KEYS ARE OPTIONAL. The app runs fully without any of them.
#  After editing .env, restart the backend. Check it worked:
#      GET http://localhost:8000/api/system/status
#  .env is git-ignored -- never commit real keys.
# ============================================================================


# ---------------------------------------------------------------------------
#  GEMINI_API_KEY  (free)  -- upgrades the AI Assistant chat to a live LLM.
#  Without it, the assistant still answers from your real path/gaps/weights
#  using a grounded templating engine (no hallucinated data).
#
#  How to get it (2 minutes):
#   1. Open  https://aistudio.google.com/apikey
#   2. Sign in with a Google account.
#   3. Click "Create API key"  ->  "Create API key in new project".
#   4. Copy the key (looks like  AIzaSy...) and paste it below.
#  Free tier: gemini-1.5-flash ~15 requests/min, plenty for this app.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Alternative to Gemini -- if set, gpt-4o-mini is used instead.
#   Get one at  https://platform.openai.com/api-keys  (paid, needs billing).
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
#  YOUTUBE_API_KEY  (free)  -- upgrades the per-milestone "Also recommended on
#  YouTube" block from a plain search link to real, view-count-ranked
#  playlists + videos. This is a SECONDARY supplement; the core course
#  recommendations and learning path come from the local dataset either way.
#
#  How to get it (5 minutes):
#   1. Open  https://console.cloud.google.com/  and sign in.
#   2. Top bar -> project dropdown -> "New Project" -> name it -> Create.
#      (or reuse the project Google AI Studio made for your Gemini key)
#   3. Enable the API:
#        https://console.cloud.google.com/apis/library/youtube.googleapis.com
#        -> click "Enable".
#   4. Create the key:
#        https://console.cloud.google.com/apis/credentials
#        -> "Create Credentials" -> "API key" -> copy it (AIzaSy...).
#   5. (Optional) click the key -> "Restrict key" -> API restrictions ->
#        select "YouTube Data API v3" -> Save.
#   6. Paste the key below.
#  Free quota: 10,000 units/day (~100 units per skill search; cached per run).
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# Generate per-course quizzes with the LLM instead of the built-in question bank.
# Slow and uses LLM quota; off by default. The offline bank + a generic fallback
# already give every course a 3-4 question quiz.
COURSE_QUIZ_LLM=false


# ---------------------------------------------------------------------------
#  Everything below has working defaults -- only change if you need to.
# ---------------------------------------------------------------------------

# Course catalog + fitted-model cache. Regenerate the dataset with:
#   python -m scripts.generate_dataset
# COURSES_CSV=app/data/courses.csv
# ML_CACHE_DIR=app/ml/cache

# ---------------------------------------------------------------------------
#  MongoDB Atlas -- REQUIRED. All app data (users, profiles, learning paths,
#  progress) is stored here. Create a free cluster at https://cloud.mongodb.com
#  then paste the connection string. Username/password can be in the URI or set
#  separately below (they are URL-encoded and injected automatically).
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=pathfinder

# Secret used to sign JWT access tokens -- set to a long random string in prod.
SECRET_KEY=change-me-to-a-long-random-string

# Origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
